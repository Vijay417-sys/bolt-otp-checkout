# Frontend environment variables
#
# Copy to `.env` for local development, or set these in Vercel project settings.
# Vite inlines VITE_* variables at BUILD time, so redeploy after changing them.

# Base URL of the Spring Boot API, without a trailing slash.
#   Local:  http://localhost:8080
#   Prod:   https://your-backend.onrender.com
#
# Leave empty to use same-origin requests (useful when the frontend is served
# behind a proxy that also forwards /api to the backend).
VITE_API_BASE_URL=http://localhost:8080
