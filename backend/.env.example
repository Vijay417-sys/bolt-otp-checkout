# Backend environment variables
#
# Copy to `.env` for local development, or set these as environment variables in
# your hosting provider (Render). NEVER commit a filled-in .env file.

# JDBC connection string.
#   Local:   jdbc:postgresql://localhost:5432/bolt_checkout
#   Supabase (Session pooler, port 5432):
#     jdbc:postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Supabase (Transaction pooler, port 6543) for serverless/ pooled access:
#     jdbc:postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Supabase (IPv4 direct, if IPv6 is unavailable):
#     jdbc:postgresql://db.<project-ref>:<PASSWORD>@aws-0-<region>.supabase.co:5432/postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/bolt_checkout

# Database credentials. Supabase defaults to the `postgres` role.
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# Comma-separated list of browser origins allowed to call the API.
# Production example: https://your-app.vercel.app
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Secret used to sign the short-lived session token issued after a successful
# OTP verification. Generate a strong random value, e.g.:
#   openssl rand -base64 48
SESSION_TOKEN_SECRET=

# Optional: connection pool size (default 5).
DB_POOL_SIZE=5

# Optional: override the HTTP port. Render sets PORT automatically.
PORT=8080
