# Backend environment variables
#
# Copy to `.env` for local development, or set these as environment variables in
# your hosting provider (Render). NEVER commit a filled-in .env file.

# JDBC connection string.
#   Local:
#     jdbc:mysql://localhost:3306/bolt_checkout?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
#
# Managed MySQL (PlanetScale, AWS RDS, Cloud SQL, Aiven, ...):
#     jdbc:mysql://<host>:3306/<database>?useSSL=true&serverTimezone=UTC
#
# Notes on the parameters:
#   useSSL / allowPublicKeyRetrieval  - set true in production if your host requires TLS
#   serverTimezone=UTC                - avoids driver/server timezone mismatches
#   characterEncoding=UTF-8           - utf8mb4 content
DATABASE_URL=jdbc:mysql://localhost:3306/bolt_checkout?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8

# Database credentials.
DATABASE_USERNAME=bolt
DATABASE_PASSWORD=

# Comma-separated list of browser origins allowed to call the API.
# Production example: https://your-app.vercel.app
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Secret used to sign the short-lived session token issued after a successful
# OTP verification. Generate a strong random value, e.g.:
#   openssl rand -base64 48
# The application refuses to start on the prod profile with the built-in default.
SESSION_TOKEN_SECRET=

# Optional: connection pool size (default 5).
DB_POOL_SIZE=5

# Optional: override the HTTP port. Render sets PORT automatically.
PORT=8080

# ---------------------------------------------------------------------------
# Login-code hardening.
#
# A 6-digit code has a million possible values, so expiry, attempt limiting and
# per-IP rate limiting are all needed - none of them is sufficient alone.
# ---------------------------------------------------------------------------

# How long a login code stays valid, in minutes.
OTP_TTL_MINUTES=10

# Wrong codes allowed per account before it is locked.
OTP_MAX_ATTEMPTS=5

# How long the account stays locked, in minutes.
OTP_LOCKOUT_MINUTES=15

# Requests per minute allowed per IP address, per endpoint. 0 disables the limiter.
# /verify is tight because it is the one worth grinding; /recognize is looser
# because the checkout form calls it on every debounced keystroke.
RATE_LIMIT_VERIFY_PER_MINUTE=10
RATE_LIMIT_RECOGNIZE_PER_MINUTE=60

# Send HSTS. Only has an effect over an already-secure (HTTPS) request, and is
# forced on by the prod profile.
HSTS_ENABLED=false
